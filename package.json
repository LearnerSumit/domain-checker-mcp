{
  "name": "domain-checker-mcp",
  "version": "1.0.0",
  "description": "Production-ready MCP server for checking domain-name availability via the RapidAPI Domain Status API.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "domain-checker-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "dev:stdio": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:http": "node dist/dev.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect": "npx -y @modelcontextprotocol/inspector"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "domain",
    "availability",
    "whois",
    "rapidapi",
    "vercel"
  ],
  "author": "Sumit Kumar <sumitdbg255@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LearnerSumit/domain-checker-mcp.git"
  },
  "homepage": "https://domain-checker-mcp.vercel.app",
  "bugs": {
    "url": "https://github.com/LearnerSumit/domain-checker-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "mcp-handler": "^2.1.1",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
