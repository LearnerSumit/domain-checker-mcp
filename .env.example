# -----------------------------------------------------------------------------
# RapidAPI credentials for the "Domain Status" API
# https://rapidapi.com/  ->  Domain Status  ->  copy your "x-rapidapi-key"
# -----------------------------------------------------------------------------
RAPIDAPI_KEY=your_rapidapi_key_here

# -----------------------------------------------------------------------------
# Optional overrides (safe defaults are used when unset)
# -----------------------------------------------------------------------------

# Upstream request timeout in milliseconds (default: 10000)
# RAPIDAPI_TIMEOUT_MS=10000

# RapidAPI host header / upstream base (rarely needs changing)
# RAPIDAPI_HOST=domainstatus.p.rapidapi.com

# Local HTTP dev server port (npm run dev) (default: 3000)
# PORT=3000

# Log level: debug | info | warn | error | silent (default: info)
# LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Abuse protection for a PUBLIC / shared deployment
# Per-client (per-IP) cap on tool calls. Protects your shared RapidAPI quota.
# Set RATE_LIMIT_MAX=0 to disable entirely (fine for a private instance).
# -----------------------------------------------------------------------------
# RATE_LIMIT_MAX=15
# RATE_LIMIT_WINDOW_MS=60000
