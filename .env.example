# -----------------------------------------------------------------------------
# No credentials required. Domain checks query public RDAP servers directly,
# resolved via the IANA bootstrap registry (https://data.iana.org/rdap/dns.json).
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Optional overrides (safe defaults are used when unset)
# -----------------------------------------------------------------------------

# Upstream request timeout in milliseconds (default: 10000)
# REQUEST_TIMEOUT_MS=10000

# Local HTTP dev server port (npm run dev) (default: 3000)
# PORT=3000

# Log level: debug | info | warn | error | silent (default: info)
# LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Abuse protection for a PUBLIC / shared deployment
# Per-client (per-IP) cap on tool calls. Protects upstream RDAP servers from a
# single abusive caller. Set RATE_LIMIT_MAX=0 to disable entirely (fine for a
# private instance).
# -----------------------------------------------------------------------------
# RATE_LIMIT_MAX=15
# RATE_LIMIT_WINDOW_MS=60000
